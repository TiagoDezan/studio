---
// Pixel icons drawn on a 12x12 grid ("#" = filled cell)
interface Props { name: string; size?: number }
const { name, size = 44 } = Astro.props;
const maps: Record<string, string[]> = {
  phone: [
    '...######...',
    '..#......#..',
    '..#.####.#..',
    '..#......#..',
    '..#......#..',
    '..#......#..',
    '..#......#..',
    '..#......#..',
    '..#......#..',
    '..#..##..#..',
    '..#......#..',
    '...######...',
  ],
  web: [
    '############',
    '#..........#',
    '#.#.#......#',
    '############',
    '#..........#',
    '#.####.###.#',
    '#..........#',
    '#.####.###.#',
    '#..........#',
    '#.########.#',
    '#..........#',
    '############',
  ],
  system: [
    '#####..#####',
    '#...#..#...#',
    '#...####...#',
    '#...#..#...#',
    '#####..#####',
    '..#......#..',
    '..#......#..',
    '..########..',
    '.....##.....',
    '...######...',
    '...#....#...',
    '...######...',
  ],
  shield: [
    '....####....',
    '.##########.',
    '.#........#.',
    '.#........#.',
    '.#.....#..#.',
    '.#....##..#.',
    '.#.#.##...#.',
    '.#..##....#.',
    '..#......#..',
    '...#....#...',
    '....#..#....',
    '.....##.....',
  ],
  game: [
    '............',
    '..########..',
    '.#........#.',
    '#..#.......#',
    '#.###...#..#',
    '#..#...#.#.#',
    '#.......#..#',
    '#..........#',
    '#...####...#',
    '.#..#..#..#.',
    '..##....##..',
    '............',
  ],
};
const grid = maps[name] ?? maps.web;
const cells: [number, number][] = [];
grid.forEach((row, y) => [...row].forEach((c, x) => c === '#' && cells.push([x, y])));
---
<svg class="icon" width={size} height={size} viewBox="0 0 12 12" aria-hidden="true" shape-rendering="crispEdges">
  {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="currentColor" />)}
</svg>
