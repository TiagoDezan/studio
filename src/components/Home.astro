---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t, pick, projects, langPath, langLabel, LANGS, type Lang, type Project } from '../data/content';
import { getSettings } from '../lib/store';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSettings();
const p = (v: Record<Lang, string>) => pick(v, lang);

const order = s.projectOrder.length ? s.projectOrder : projects.map((x) => x.id);
const visible = projects
  .filter((x) => !s.hiddenProjects.includes(x.id))
  .sort((a, b) => (order.indexOf(a.id) + 1 || 99) - (order.indexOf(b.id) + 1 || 99));
const clients = visible.filter((x) => x.kind === 'client');
const own = visible.filter((x) => x.kind === 'own');
const examples = t.hero.searchExamples[lang];
const wa = s.whatsapp.replace(/[^\d]/g, '');
const ig = s.instagram.replace(/^@/, '');
const themeLabels = {
  pt: { auto: 'Tema: automático', light: 'Tema: claro', dark: 'Tema: escuro' },
  es: { auto: 'Tema: automático', light: 'Tema: claro', dark: 'Tema: oscuro' },
  en: { auto: 'Theme: auto', light: 'Theme: light', dark: 'Theme: dark' },
}
---
<Base title={p(t.meta.title)} description={p(t.meta.description)} lang={lang}>
  {s.announcement.enabled && s.announcement.text && (
    <div class="announce pixel" role="status"><span>{s.announcement.text}</span></div>
  )}

  <header class="top">
    <div class="wrap top-in">
      <a href={langPath[lang]} class="brand" aria-label="Noob Perdido Studio">
        <Logo class="brand-logo" animated={false} />
        <span class="pixel brand-tag">Studio</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#servicos">{p(t.nav.services)}</a>
        <a href="#projetos">{p(t.nav.work)}</a>
        <a href="#processo">{p(t.nav.process)}</a>
      </nav>
      <div class="top-actions">
        <button class="theme-btn" type="button" id="theme-btn" data-labels={JSON.stringify(themeLabels[lang])} aria-label={themeLabels[lang].auto} title={themeLabels[lang].auto}>
          <svg class="ti ti-auto" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
          <svg class="ti ti-light" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
          <svg class="ti ti-dark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
        </button>
        <div class="langs" role="group" aria-label="Language">
          {LANGS.map((l) => (
            <a href={langPath[l]} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{langLabel[l]}</a>
          ))}
        </div>
        <a class="btn small" href="#contato">{p(t.nav.contact)}</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="pixel eyebrow">{p(t.hero.eyebrow)}</p>
          <h1>{p(t.hero.title)}</h1>
          <p class="lead">{p(t.hero.lead)}</p>

          <form class="search" id="hero-search" action="#contato" autocomplete="off">
            <label for="q" class="sr-only">{p(t.hero.searchLabel)}</label>
            <span class="search-caret" aria-hidden="true"></span>
            <input id="q" name="q" type="text" maxlength="160" placeholder={examples[0]} data-examples={JSON.stringify(examples)} />
            <button type="submit" aria-label={p(t.hero.searchLabel)}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15 15l6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="square"/></svg>
            </button>
          </form>
          <p class="hint">{p(t.hero.searchHint)}</p>

          <div class="hero-meta">
            <span class={`status ${s.available ? 'open' : 'busy'}`}><i></i>{s.available ? p(t.status.open) : p(t.status.busy)}</span>
            <a href="#projetos" class="link-arrow">{p(t.hero.cta)} <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="hero-card">
            <span class="pixel hud hud-tl">1UP · {lang === 'en' ? 'YOU' : lang === 'es' ? 'TÚ' : 'VOCÊ'}</span>
            <span class="pixel hud hud-tr">HI 99999</span>
            <Logo class="hero-logo" />
            <span class="pixel hud hud-b">Press start</span>
          </div>
        </div>
      </div>
      <div class="wrap stats">
        {t.stats.map((st) => (
          <div class="stat reveal"><b>{st.value}</b><span>{p(st.label)}</span></div>
        ))}
      </div>
    </section>

    <section class="section services" id="servicos">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="pixel eyebrow">{p(t.services.eyebrow)}</p>
          <h2>{p(t.services.title)}</h2>
        </div>
        <ul class="svc-grid">
          {t.services.items.map((it, i) => (
            <li class="svc reveal" style={`--d:${i * 70}ms`}>
              <Icon name={it.icon} />
              <h3>{p(it.title)}</h3>
              <p>{p(it.body)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section work" id="projetos">
      <div class="wrap">
        {clients.length > 0 && (
          <>
            <div class="section-head reveal">
              <p class="pixel eyebrow">{p(t.work.clientsEyebrow)}</p>
              <h2>{p(t.work.clientsTitle)}</h2>
            </div>
            <div class="clients">
              {clients.map((c: Project, i: number) => (
                <article class={`client reveal ${i % 2 ? 'flip' : ''}`}>
                  <div class="client-img"><img src={c.image} alt="" loading="lazy" decoding="async" width="1200" height="630" /></div>
                  <div class="client-body">
                    <p class="pixel tag">{p(c.tag)}</p>
                    <h3>{c.name}</h3>
                    <p>{p(c.summary)}</p>
                    <ul class="chips">{c.stack.map((x) => <li>{x}</li>)}</ul>
                    {c.url && <a class="btn ghost" href={c.url} target="_blank" rel="noopener">{c.urlLabel ? p(c.urlLabel) : c.url} <span aria-hidden="true">↗</span></a>}
                  </div>
                </article>
              ))}
            </div>
          </>
        )}

        {own.length > 0 && (
          <>
            <div class="section-head reveal own-head">
              <p class="pixel eyebrow">{p(t.work.ownEyebrow)}</p>
              <h2>{p(t.work.ownTitle)}</h2>
            </div>
            <div class="games">
              {own.map((g: Project, i: number) => (
                <article class="game reveal" style={`--d:${i * 80}ms`}>
                  <div class="game-img">
                    <img src={g.image} alt="" loading="lazy" decoding="async" />
                    {g.status && <span class="pixel badge">{p(g.status)}</span>}
                  </div>
                  <div class="game-body">
                    <p class="pixel tag">{p(g.tag)}</p>
                    <h3>{g.name}</h3>
                    <p>{p(g.summary)}</p>
                    <div class="game-foot">
                      <ul class="chips">{g.stack.map((x) => <li>{x}</li>)}</ul>
                      {g.url && <a class="link-arrow" href={g.url} target="_blank" rel="noopener">{g.urlLabel ? p(g.urlLabel) : 'Info'} <span aria-hidden="true">↗</span></a>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <section class="section process" id="processo">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="pixel eyebrow">{p(t.process.eyebrow)}</p>
          <h2>{p(t.process.title)}</h2>
        </div>
        <ol class="steps">
          {t.process.steps.map((st, i) => (
            <li class="step reveal" style={`--d:${i * 90}ms`}>
              <span class="pixel lvl">LVL {i + 1}</span>
              <h3>{p(st.title)}</h3>
              <p>{p(st.body)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section contact" id="contato">
      <div class="wrap contact-in">
        <div class="contact-copy reveal">
          <p class="pixel eyebrow">{p(t.contact.eyebrow)}</p>
          <h2>{p(t.contact.title)}</h2>
          <p class="lead">{p(t.contact.lead)}</p>
          <div class="direct">
            <p>{p(t.contact.or)}</p>
            <ul>
              {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
              {wa && <li><a href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a></li>}
              {ig && <li><a href={`https://instagram.com/${ig}`} target="_blank" rel="noopener">@{ig}</a></li>}
            </ul>
          </div>
        </div>
        <form class="form reveal" id="contact-form" method="post" action="/api/contact" data-ok={p(t.contact.ok)} data-fail={p(t.contact.fail)} data-sending={p(t.contact.sending)}>
          <input type="hidden" name="lang" value={lang} />
          <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="row">
            <label>
              <span>{p(t.contact.name)}</span>
              <input name="name" required maxlength="120" autocomplete="name" />
            </label>
            <label>
              <span>{p(t.contact.email)}</span>
              <input name="email" type="email" required maxlength="160" autocomplete="email" />
            </label>
          </div>
          <fieldset>
            <legend>{p(t.contact.type)}</legend>
            <div class="pills">
              {t.contact.types[lang].map((ty, i) => (
                <label class="pill"><input type="radio" name="type" value={ty} checked={i === 0} /><span>{ty}</span></label>
              ))}
            </div>
          </fieldset>
          <label>
            <span>{p(t.contact.message)}</span>
            <textarea name="message" id="message" rows="5" required maxlength="4000" placeholder={p(t.contact.messagePh)}></textarea>
          </label>
          <div class="form-foot">
            <button class="btn" type="submit">{p(t.contact.send)}</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-pattern" aria-hidden="true"></div>
    <div class="wrap foot-in">
      <Logo class="foot-logo" />
      <div class="foot-row">
        <p class="pixel">© {new Date().getFullYear()} Noob Perdido Studio</p>
        <p class="muted">{p(t.footer.rights)}</p>
        <div class="langs">
          {LANGS.map((l) => <a href={langPath[l]} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{langLabel[l]}</a>)}
        </div>
      </div>
    </div>
  </footer>

  <script>
    // theme: auto (system) → light → dark → auto
    const tb = document.getElementById('theme-btn');
    const setLabel = () => {
      if (!tb) return;
      const labels = JSON.parse(tb.dataset.labels || '{}');
      const cur = document.documentElement.dataset.theme || 'auto';
      tb.setAttribute('aria-label', labels[cur]); tb.title = labels[cur];
    };
    setLabel();
    tb?.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme || 'auto';
      const next = cur === 'auto' ? 'light' : cur === 'light' ? 'dark' : 'auto';
      if (next === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = next;
      try { next === 'auto' ? localStorage.removeItem('np_theme') : localStorage.setItem('np_theme', next); } catch {}
      setLabel();
    });

    // remember a manual language choice (the server uses it on the next visit to /)
    document.querySelectorAll<HTMLAnchorElement>('.langs a[hreflang]').forEach((a) => a.addEventListener('click', () => {
      document.cookie = `np_lang=${a.hreflang}; path=/; max-age=31536000; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}`;
    }));

    // reveal on scroll
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // header shadow
    const top = document.querySelector('.top');
    const onScroll = () => top?.classList.toggle('scrolled', window.scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // hero search: cycle placeholders, send the idea into the contact form
    const q = document.getElementById('q') as HTMLInputElement | null;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (q) {
      const ex: string[] = JSON.parse(q.dataset.examples || '[]');
      let i = 0;
      if (!reduce && ex.length > 1) setInterval(() => { if (document.activeElement !== q && !q.value) q.placeholder = ex[(i = (i + 1) % ex.length)]; }, 2600);
      document.getElementById('hero-search')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const v = q.value.trim() || q.placeholder;
        if (v.trim().toLowerCase() === '/painel') { location.href = '/painel'; return; }
        const m = document.getElementById('message') as HTMLTextAreaElement | null;
        if (m && !m.value) m.value = v.charAt(0).toUpperCase() + v.slice(1) + '. ';
        document.getElementById('contato')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        setTimeout(() => (document.querySelector('#contact-form input[name=name]') as HTMLInputElement | null)?.focus({ preventScroll: true }), reduce ? 0 : 700);
      });
    }

    // konami code → hidden panel
    const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let k = 0;
    addEventListener('keydown', (e) => { k = e.key === seq[k] ? k + 1 : (e.key === seq[0] ? 1 : 0); if (k === seq.length) location.href = '/painel'; });

    // contact form
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const status = form.querySelector('.form-status') as HTMLElement;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = form.dataset.sending || '…';
      status.className = 'form-status'; status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.ok || 'OK';
        status.classList.add('ok');
      } catch {
        status.textContent = form.dataset.fail || 'Error';
        status.classList.add('err');
      } finally {
        btn.disabled = false; btn.textContent = label;
      }
    });
  </script>
</Base>

<style>
  .announce { background: var(--blue); color: var(--blue-ink); text-align: center; padding: 10px var(--gutter); font-size: 10px; }

  /* header */
  .top { position: sticky; top: 0; z-index: 50; background: var(--header-bg); backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .top.scrolled { border-bottom-color: var(--line); }
  .top-in { display: flex; align-items: center; gap: 24px; height: 72px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .brand :global(.brand-logo) { width: 132px; }
  .brand-tag { font-size: 8px; color: var(--accent); border: 1px solid var(--line-2); padding: 5px 7px 4px; border-radius: 6px; }
  .nav { display: flex; gap: 28px; }
  .nav a { text-decoration: none; color: var(--muted); font-weight: 600; font-size: 15px; transition: color .2s; }
  .nav a:hover { color: var(--text); }
  .top-actions { display: flex; align-items: center; gap: 16px; }
  .langs { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 10px; }
  .langs a { font: 600 12px/1 var(--font-display); letter-spacing: .06em; color: var(--faint); text-decoration: none; padding: 7px 8px; border-radius: 7px; }
  .langs a:hover { color: var(--text); }
  .langs a[aria-current] { background: var(--bg-2); color: var(--blue); }
  .theme-btn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; transition: color .2s, border-color .2s; }
  .theme-btn:hover { color: var(--text); border-color: var(--line-2); }
  .theme-btn .ti { display: none; grid-area: 1 / 1; }
  :global(html:not([data-theme])) .theme-btn .ti-auto,
  :global(html[data-theme='light']) .theme-btn .ti-light,
  :global(html[data-theme='dark']) .theme-btn .ti-dark { display: block; }
  .btn.small { min-height: 40px; padding: 0 16px; font-size: 14px; box-shadow: 0 3px 0 0 var(--blue-deep); }
  @media (max-width: 920px) { .nav { display: none; } }
  @media (max-width: 560px) {
    .top-actions { gap: 8px; }
    .top-in { gap: 12px; height: 64px; }
    .brand :global(.brand-logo) { width: 108px; }
    .brand-tag { display: none; }
    .top-actions .btn { display: none; }
  }

  /* hero */
  .hero { position: relative; padding-top: clamp(48px, 9vw, 112px); overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    background:
      radial-gradient(60% 50% at 78% 30%, rgb(50 204 254 / 0.16), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgb(50 204 254 / 0.06), transparent 70%);
  }
  .hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background-image: var(--pattern);
    background-size: 270px auto;
    opacity: var(--pattern-opacity);
    mask-image: radial-gradient(70% 60% at 70% 30%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 70% 30%, #000, transparent 75%);
  }
  .hero-in { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-copy { display: grid; gap: 22px; }
  .hero h1 { font-size: clamp(42px, 6.6vw, 84px); line-height: 0.98; letter-spacing: -0.035em; }
  .lead { color: var(--muted); font-size: clamp(17px, 1.6vw, 20px); max-width: 560px; }

  .search {
    display: flex; align-items: center; gap: 10px; max-width: 560px; margin-top: 10px;
    border: 3px solid var(--blue); border-radius: 16px; padding: 6px 6px 6px 20px;
    background: rgb(50 204 254 / 0.04);
    transition: box-shadow .25s, background .25s;
  }
  .search:focus-within { box-shadow: 0 0 0 6px rgb(50 204 254 / 0.16); background: rgb(50 204 254 / 0.07); }
  .search-caret { width: 2px; height: 24px; background: var(--text); animation: blink 1.1s steps(1) infinite; }
  .search:focus-within .search-caret { display: none; }
  .search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--text); font: 500 18px/1.2 var(--font-body); padding: 12px 0; }
  .search input::placeholder { color: var(--faint); }
  .search button { flex: none; width: 48px; height: 48px; border-radius: 11px; border: 0; background: var(--blue); color: var(--blue-ink); display: grid; place-items: center; cursor: pointer; transition: transform .2s var(--ease); }
  .search button:hover { transform: scale(1.06); }
  .hint { color: var(--faint); font-size: 14px; margin-top: -10px; }
  @keyframes blink { 50% { opacity: 0; } }

  .hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 28px; margin-top: 6px; }
  .status { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--muted); }
  .status i { width: 10px; height: 10px; background: #3ee07f; box-shadow: 0 0 0 4px rgb(62 224 127 / .16); }
  .status.busy i { background: #ffb02e; box-shadow: 0 0 0 4px rgb(255 176 46 / .16); }
  .link-arrow { font-weight: 700; color: var(--accent); text-decoration: none; font-size: 15px; white-space: nowrap; }
  .link-arrow:hover { text-decoration: underline; text-underline-offset: 4px; }

  .hero-art { position: relative; }
  .hero-card {
    aspect-ratio: 1; border-radius: 28px; display: grid; place-items: center; padding: 14%;
    background: var(--card-bg);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgb(50 204 254 / 0.25), inset 0 1px 0 rgb(255 255 255 / .04);
    position: relative; overflow: hidden;
  }
  .hero-card::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgb(255 255 255 / .018) 0 2px, transparent 2px 4px); pointer-events: none; }
  .hero-card :global(.hero-logo) { width: 100%; position: relative; }
  .hud { position: absolute; font-size: 9px; color: var(--faint); }
  .hud-tl { top: 22px; left: 24px; }
  .hud-tr { top: 22px; right: 24px; }
  .hud-b { bottom: 26px; left: 0; right: 0; text-align: center; color: var(--accent); animation: blink 1.4s steps(1) infinite; }
  @media (prefers-reduced-motion: reduce) { .hud-b { animation: none; } }
  @media (max-width: 860px) {
    .hero-in { grid-template-columns: 1fr; }
    .hero-art { order: -1; max-width: 420px; width: 100%; }
    .hero-card { aspect-ratio: 16 / 9; padding: 10% 12%; }
  }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(56px, 8vw, 104px); border-top: 1px solid var(--line); }
  .stat { display: flex; align-items: baseline; gap: 16px; padding: 28px 24px 0 0; transition-delay: var(--d, 0ms); }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--line); }
  .stat b { font: 600 clamp(40px, 5vw, 56px)/1 var(--font-display); color: var(--accent); letter-spacing: -.04em; }
  .stat span { color: var(--muted); font-size: 15px; line-height: 1.35; max-width: 18ch; }
