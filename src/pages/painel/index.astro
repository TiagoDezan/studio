---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { isAdmin, adminEnabled } from '../../lib/auth';
import { getSettings, getLeads, getStats, getProjects } from '../../lib/store';

const admin = isAdmin(Astro.cookies);
const err = Astro.url.searchParams.get('e');
const ok = Astro.url.searchParams.get('ok');
const tabs = [
  ['geral', 'Visão geral'],
  ['mensagens', 'Mensagens'],
  ['site', 'Site'],
  ['projetos', 'Projetos'],
  ['dados', 'Dados'],
] as const;
const tab = (tabs.find(([k]) => k === Astro.url.searchParams.get('tab'))?.[0]) ?? 'geral';

const s = getSettings();
const leads = admin ? getLeads() : [];
const unread = leads.filter((l) => !l.read).length;
const stats = admin ? getStats(30) : null;
const max = stats ? Math.max(1, ...stats.series.map((d) => d.count)) : 1;
const today = stats?.series.at(-1)?.count ?? 0;
const week = stats ? stats.series.slice(-7).reduce((a, b) => a + b.count, 0) : 0;
const sortedProjects = admin ? getProjects() : [];
const editId = Astro.url.searchParams.get('edit');
const editing = editId === 'new' ? null : sortedProjects.find((p) => p.id === editId) ?? null;
const showForm = tab === 'projetos' && (editId === 'new' || !!editing);
const ep = editing;
const pickerValue = ep?.imageBg && /^#[0-9a-fA-F]{6}$/.test(ep.imageBg) ? ep.imageBg : '#0d1114';
const L = [['pt', 'Português'], ['es', 'Español'], ['en', 'English']] as const;
const fmt = (iso: string) => new Date(iso).toLocaleString('pt-BR', { timeZone: 'Europe/Madrid', dateStyle: 'short', timeStyle: 'short' });
const okMsg: Record<string, string> = { saved: 'Alterações salvas.', deleted: 'Mensagem apagada.', reset: 'Estatísticas zeradas.', pdeleted: 'Projeto apagado.', missing: 'Dê um nome ao projeto.', badimg: 'Imagem inválida: use PNG, JPG, WebP, SVG, AVIF ou GIF de até 8 MB.' };
const errKeys = ['missing', 'badimg'];
---
<Base title="Painel · Noob Perdido Studio" description="Painel" noindex>
  {!admin ? (
    <main class="login">
      <form method="post" action="/painel/login" class="login-card">
        <Logo class="login-logo" />
        <p class="pixel eyebrow">Área restrita</p>
        {!adminEnabled() ? (
          <p class="alert">Painel desativado. Defina a variável <code>ADMIN_PASSWORD</code> (mínimo 8 caracteres) no servidor.</p>
        ) : (
          <>
            <label><span>Senha</span><input type="password" name="password" required autofocus autocomplete="current-password" /></label>
            {err && <p class="alert">{err === 'rate' ? 'Muitas tentativas. Espere alguns minutos.' : 'Senha incorreta.'}</p>}
            <button class="btn" type="submit">Entrar</button>
          </>
        )}
        <a href="/" class="back">← Voltar ao site</a>
      </form>
    </main>
  ) : (
    <div class="app">
      <aside class="side">
        <a href="/" class="side-logo" target="_blank" rel="noopener"><Logo animated={false} /></a>
        <nav>
          {tabs.map(([k, label]) => (
            <a href={`/painel?tab=${k}`} aria-current={k === tab ? 'page' : undefined}>
              {label}{k === 'mensagens' && unread > 0 && <span class="count">{unread}</span>}
            </a>
          ))}
        </nav>
        <form method="post" action="/painel/logout"><button class="linkbtn">Sair</button></form>
      </aside>

      <main class="main">
        {ok && okMsg[ok] && <p class={`toast ${errKeys.includes(ok) ? 'bad' : ''}`} role="status">{okMsg[ok]}</p>}

        {tab === 'geral' && stats && (
          <section>
            <h1>Visão geral</h1>
            <div class="cards">
              <div class="card"><span>Visitas hoje</span><b>{today}</b></div>
              <div class="card"><span>Últimos 7 dias</span><b>{week}</b></div>
              <div class="card"><span>Últimos 30 dias</span><b>{stats.total}</b></div>
              <div class="card"><span>Mensagens não lidas</span><b>{unread}</b></div>
            </div>
            <div class="panel">
              <h2>Visitas por dia</h2>
              <div class="chart" role="img" aria-label="Visitas nos últimos 30 dias">
                {stats.series.map((d) => (
                  <div class="bar" style={`--h:${(d.count / max) * 100}%`} title={`${d.day}: ${d.count}`}><span>{d.count || ''}</span></div>
                ))}
              </div>
              <div class="chart-axis"><span>{stats.series[0].day.slice(5)}</span><span>hoje</span></div>
            </div>
            <div class="two">
              <div class="panel">
                <h2>Por idioma</h2>
                <ul class="kv">
                  {[['/', 'Português'], ['/es/', 'Español'], ['/en/', 'English']].map(([k, n]) => <li><span>{n}</span><b>{stats.paths[k] || 0}</b></li>)}
                </ul>
              </div>
              <div class="panel">
                <h2>De onde vêm</h2>
                {stats.topReferrers.length ? (
                  <ul class="kv">{stats.topReferrers.map(([h, n]) => <li><span>{h}</span><b>{n}</b></li>)}</ul>
                ) : <p class="muted">Ainda sem referências externas (acessos diretos não entram aqui).</p>}
              </div>
            </div>
            <div class="panel status-row">
              <div>
                <h2>Estado do site</h2>
                <p class="muted">{s.maintenance ? 'Em manutenção: visitantes veem a página "Voltamos já". Você continua vendo o site normal.' : 'No ar.'} {s.available ? 'Selo "Aceitando novos projetos" ativo.' : 'Selo "Agenda cheia" ativo.'}</p>
              </div>
              <form method="post" action="/painel/action">
                <input type="hidden" name="action" value="toggleMaintenance" />
                <button class={`btn ${s.maintenance ? '' : 'ghost'}`}>{s.maintenance ? 'Tirar da manutenção' : 'Ativar manutenção'}</button>
              </form>
            </div>
          </section>
        )}

        {tab === 'mensagens' && (
          <section>
            <div class="head-row">
              <h1>Mensagens</h1>
              {leads.length > 0 && <a class="btn ghost small" href="/painel/export?f=csv">Exportar CSV</a>}
            </div>
            {leads.length === 0 ? (
              <div class="panel empty"><p>Nenhuma mensagem ainda. Quando alguém usar o formulário do site, aparece aqui.</p></div>
            ) : (
              <ul class="leads">
                {[...leads].sort((a, b) => Number(!!b.starred) - Number(!!a.starred)).map((l) => (
                  <li class={`lead ${l.read ? 'read' : ''}`}>
                    <div class="lead-top">
                      <div>
                        <b>{l.starred && '★ '}{l.name}</b> <a href={`mailto:${l.email}?subject=${encodeURIComponent('Noob Perdido Studio')}`}>{l.email}</a>
                        <p class="muted small">{fmt(l.at)} · {l.type} · {l.lang.toUpperCase()}</p>
                      </div>
                      <div class="lead-actions">
                        <form method="post" action="/painel/action"><input type="hidden" name="action" value="leadStar" /><input type="hidden" name="id" value={l.id} /><input type="hidden" name="value" value={l.starred ? '0' : '1'} /><button class="linkbtn">{l.starred ? 'Desmarcar' : 'Destacar'}</button></form>
                        <form method="post" action="/painel/action"><input type="hidden" name="action" value="leadRead" /><input type="hidden" name="id" value={l.id} /><input type="hidden" name="value" value={l.read ? '0' : '1'} /><button class="linkbtn">{l.read ? 'Marcar não lida' : 'Marcar lida'}</button></form>
                        <form method="post" action="/painel/action" class="confirm"><input type="hidden" name="action" value="leadDelete" /><input type="hidden" name="id" value={l.id} /><button class="linkbtn danger">Apagar</button></form>
                      </div>
                    </div>
                    <p class="lead-msg">{l.message}</p>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {tab === 'site' && (
          <section>
            <h1>Site</h1>
            <form method="post" action="/painel/action" class="panel form">
              <input type="hidden" name="action" value="settings" />
              <h2>Disponibilidade</h2>
              <label class="switch"><input type="checkbox" name="available" checked={s.available} /><span>Aceitando novos projetos <em>(desligado mostra "Agenda cheia")</em></span></label>
              <label class="switch"><input type="checkbox" name="maintenance" checked={s.maintenance} /><span>Modo manutenção <em>(visitantes veem "Voltamos já")</em></span></label>

              <h2>Faixa de aviso no topo</h2>
              <label class="switch"><input type="checkbox" name="announcementEnabled" checked={s.announcement.enabled} /><span>Mostrar faixa</span></label>
              <label><span>Texto da faixa</span><input name="announcementText" value={s.announcement.text} maxlength="200" placeholder="Ex.: Vagas abertas para projetos em janeiro" /></label>

              <h2>Contato</h2>
              <div class="grid2">
                <label><span>E-mail público</span><input type="email" name="email" value={s.email} /></label>
                <label><span>WhatsApp (com DDI)</span><input name="whatsapp" value={s.whatsapp} placeholder="+34 600 000 000" /></label>
                <label><span>Instagram</span><input name="instagram" value={s.instagram} placeholder="@noobperdido" /></label>
                <label><span>Webhook de aviso (opcional)</span><input type="url" name="webhookUrl" value={s.webhookUrl} placeholder="https://discord.com/api/webhooks/…" /></label>
              </div>
              <p class="muted small">O webhook recebe um POST a cada nova mensagem do formulário (funciona com Discord, Slack, Google Chat, n8n, Zapier…).</p>
              <div><button class="btn">Salvar</button></div>
            </form>
          </section>
        )}

        {tab === 'projetos' && !showForm && (
          <section>
            <div class="head-row">
              <h1>Projetos</h1>
              <a class="btn small" href="/painel?tab=projetos&edit=new">+ Novo projeto</a>
            </div>
            <form method="post" action="/painel/action" class="panel form">
              <input type="hidden" name="action" value="projects" />
              <p class="muted">Escolha o que aparece no site e em que ordem (número menor aparece primeiro, dentro de Clientes e de Criações próprias).</p>
              <table class="ptable">
                <thead><tr><th>Mostrar</th><th></th><th>Projeto</th><th>Tipo</th><th>Ordem</th><th></th></tr></thead>
                <tbody>
                  {sortedProjects.map((p, i) => (
                    <tr>
                      <td><input type="checkbox" name={`show:${p.id}`} checked={p.visible} aria-label={`Mostrar ${p.name}`} /></td>
                      <td><span class="thumb" style={p.imageBg ? `background:${p.imageBg}` : undefined}>{p.image && <img src={p.image} alt="" class={p.imageFit === 'contain' ? 'contain' : ''} />}</span></td>
                      <td><b>{p.name}</b></td>
                      <td class="muted">{p.kind === 'client' ? 'Cliente' : 'Própria'}</td>
                      <td><input type="number" name={`order:${p.id}`} value={i + 1} min="1" max="99" class="num" aria-label={`Ordem de ${p.name}`} /></td>
                      <td><a href={`/painel?tab=projetos&edit=${p.id}`}>Editar</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div><button class="btn">Salvar visibilidade e ordem</button></div>
            </form>
          </section>
        )}

        {showForm && (
          <section>
            <p><a href="/painel?tab=projetos" class="back-link">← Projetos</a></p>
            <h1>{ep ? `Editar ${ep.name}` : 'Novo projeto'}</h1>
            <form method="post" action="/painel/action" enctype="multipart/form-data" class="panel form">
              <input type="hidden" name="action" value="projectSave" />
              {ep && <input type="hidden" name="id" value={ep.id} />}
              <div class="grid2">
                <label><span>Nome *</span><input name="name" required maxlength="120" value={ep?.name ?? ''} /></label>
                <label><span>Tipo</span>
                  <select name="kind">
                    <option value="client" selected={ep?.kind === 'client'}>Cliente</option>
                    <option value="own" selected={!ep || ep.kind === 'own'}>Criação própria</option>
                  </select>
                </label>
                <label><span>Link (opcional)</span><input type="url" name="url" placeholder="https://…" value={ep?.url ?? ''} /></label>
                <label><span>Tecnologias (separadas por vírgula)</span><input name="stack" placeholder="Swift, SwiftUI, Supabase" value={ep?.stack.join(', ') ?? ''} /></label>
              </div>
              <div class="switches">
                <label class="switch"><input type="checkbox" name="visible" checked={ep ? ep.visible : true} /><span>Mostrar no site</span></label>
                <label class="inline"><span>Ordem</span><input type="number" name="order" min="1" max="99" class="num" value={ep?.order ?? sortedProjects.length + 1} /></label>
              </div>

              <h2>Imagem</h2>
              <div class="img-row">
                <div class="preview" id="preview" style={ep?.imageBg ? `background:${ep.imageBg}` : undefined}>
                  {ep?.image ? <img src={ep.image} alt="" class={ep.imageFit === 'contain' ? 'contain' : ''} /> : <span class="muted small">Sem imagem</span>}
                </div>
                <div class="img-fields">
                  <label><span>Enviar imagem (PNG, JPG, WebP, SVG, até 8 MB)</span><input type="file" name="imageFile" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/avif,image/gif" /></label>
                  <label><span>Como mostrar</span>
                    <select name="imageFit" id="imageFit">
                      <option value="cover" selected={ep?.imageFit !== 'contain'}>Foto / banner (preenche o espaço)</option>
                      <option value="contain" selected={ep?.imageFit === 'contain'}>Logo (centralizado sobre uma cor)</option>
                    </select>
                  </label>
                  <label><span>Cor de fundo do logo</span><span class="color"><input type="color" id="bgpick" value={pickerValue} /><input name="imageBg" id="imageBg" placeholder="#3e4c59" value={ep?.imageBg ?? ''} maxlength="9" /></span></label>
                  {ep?.image && <label class="switch"><input type="checkbox" name="removeImage" /><span>Remover a imagem atual</span></label>}
                </div>
              </div>

              <h2>Textos</h2>
              <p class="muted small">Só o português é obrigatório na prática: se espanhol ou inglês ficarem vazios, o site mostra o texto em português.</p>
              <div class="langtabs" role="tablist">
                {L.map(([k, n], i) => <button type="button" role="tab" class="ltab" data-l={k} aria-selected={i === 0 ? 'true' : 'false'}>{n}</button>)}
              </div>
              {L.map(([k], i) => (
                <div class="lpane" data-l={k} hidden={i !== 0}>
                  <label><span>Etiqueta curta</span><input name={`tag_${k}`} maxlength="80" placeholder={k === 'pt' ? 'Ex.: App + web' : ''} value={ep?.tag?.[k] ?? ''} /></label>
                  <label><span>Descrição</span><textarea name={`summary_${k}`} rows="4" maxlength="700">{ep?.summary?.[k] ?? ''}</textarea></label>
                  <div class="grid2">
                    <label><span>Texto do botão (opcional)</span><input name={`urlLabel_${k}`} maxlength="60" placeholder={k === 'pt' ? 'Ver projeto' : k === 'es' ? 'Ver proyecto' : 'View project'} value={ep?.urlLabel?.[k] ?? ''} /></label>
                    <label><span>Selo na imagem (opcional)</span><input name={`status_${k}`} maxlength="40" placeholder={k === 'pt' ? 'Ex.: Em desenvolvimento' : ''} value={ep?.status?.[k] ?? ''} /></label>
                  </div>
                </div>
              ))}
              <div class="form-actions">
                <button class="btn">Salvar projeto</button>
                <a class="btn ghost" href="/painel?tab=projetos">Cancelar</a>
              </div>
            </form>
            {ep && (
              <form method="post" action="/painel/action" class="confirm del-form">
                <input type="hidden" name="action" value="projectDelete" /><input type="hidden" name="id" value={ep.id} />
                <button class="btn ghost danger">Apagar este projeto</button>
              </form>
            )}
          </section>
        )}

        {tab === 'dados' && (
          <section>
            <h1>Dados</h1>
            <div class="panel">
              <h2>Backup</h2>
              <p class="muted">Baixe tudo (configurações, mensagens e estatísticas) em JSON, ou só as mensagens em CSV para abrir no Excel/Numbers.</p>
              <div class="btns"><a class="btn ghost" href="/painel/export">Backup completo (JSON)</a><a class="btn ghost" href="/painel/export?f=csv">Mensagens (CSV)</a></div>
            </div>
            <div class="panel">
              <h2>Zerar estatísticas</h2>
              <p class="muted">Apaga a contagem de visitas e as origens. Mensagens e configurações ficam.</p>
              <form method="post" action="/painel/action" class="confirm"><input type="hidden" name="action" value="resetStats" /><button class="btn ghost danger">Zerar estatísticas</button></form>
            </div>
            <div class="panel">
              <h2>Como entrar aqui</h2>
              <p class="muted">O painel fica em <code>/painel</code> e não tem link no site. Atalhos: digitar <code>/painel</code> na barra de busca da home, ou o código Konami (↑ ↑ ↓ ↓ ← → ← → B A) em qualquer página.</p>
            </div>
          </section>
        )}
      </main>
    </div>
  )}
  <script>
    // project editor: language tabs, colour picker, live preview
    document.querySelectorAll<HTMLButtonElement>('.ltab').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.ltab').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      document.querySelectorAll<HTMLElement>('.lpane').forEach((p) => (p.hidden = p.dataset.l !== b.dataset.l));
    }));
    const pick = document.getElementById('bgpick') as HTMLInputElement | null;
    const bg = document.getElementById('imageBg') as HTMLInputElement | null;
    const prev = document.getElementById('preview');
    const fit = document.getElementById('imageFit') as HTMLSelectElement | null;
    const paint = () => { if (prev && bg) prev.style.background = /^#[0-9a-f]{3,8}$/i.test(bg.value) ? bg.value : ''; };
    pick?.addEventListener('input', () => { if (bg) bg.value = pick.value; paint(); });
    bg?.addEventListener('input', () => { if (pick && /^#[0-9a-f]{6}$/i.test(bg.value)) pick.value = bg.value; paint(); });
    fit?.addEventListener('change', () => prev?.querySelector('img')?.classList.toggle('contain', fit.value === 'contain'));
    document.querySelector<HTMLInputElement>('input[name=imageFile]')?.addEventListener('change', (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f || !prev) return;
      prev.innerHTML = '';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      if (fit?.value === 'contain') img.className = 'contain';
      prev.appendChild(img);
    });

    document.querySelectorAll('form.confirm').forEach((f) => f.addEventListener('submit', (e) => {
      const b = f.querySelector('button');
      if (b && !b.dataset.armed) { e.preventDefault(); b.dataset.armed = '1'; b.dataset.label = b.textContent || ''; b.textContent = 'Clique de novo para confirmar'; setTimeout(() => { delete b.dataset.armed; b.textContent = b.dataset.label || ''; }, 3000); }
    }));
  </script>
</Base>

<style>
  .login { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(50% 40% at 50% 30%, rgb(50 204 254 / .12), transparent 70%); }
  .login-card { width: min(100%, 380px); display: grid; gap: 18px; padding: 36px 28px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-1); }
  .login-card :global(.login-logo) { width: 200px; margin-bottom: 8px; }
  .back { color: var(--faint); font-size: 14px; text-decoration: none; }
  .alert { color: #ff8a8a; font-size: 14px; }
  label { display: grid; gap: 8px; }
  label > span { font-size: 14px; font-weight: 700; }
  input:not([type=checkbox]) { width: 100%; font: 500 15px/1.4 var(--font-body); color: var(--text); background: var(--bg); border: 1px solid var(--line-2); border-radius: 10px; padding: 11px 12px; }
  input:focus { outline: 0; border-color: var(--blue); box-shadow: 0 0 0 4px rgb(50 204 254 / .14); }
  code { font-size: .9em; background: var(--bg-2); padding: 2px 6px; border-radius: 6px; color: var(--accent); }

  .app { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
  .side { border-right: 1px solid var(--line); padding: 24px 16px; display: flex; flex-direction: column; gap: 28px; position: sticky; top: 0; height: 100vh; background: var(--bg-1); }
  .side-logo { padding: 0 8px; }
  .side-logo :global(svg) { width: 140px; }
  .side nav { display: grid; gap: 2px; }
  .side nav a { display: flex; justify-content: space-between; align-items: center; text-decoration: none; color: var(--muted); font-weight: 600; font-size: 15px; padding: 10px 12px; border-radius: 10px; }
  .side nav a:hover { color: var(--text); background: var(--bg-2); }
  .side nav a[aria-current] { color: var(--text); background: var(--bg-2); box-shadow: inset 3px 0 0 var(--blue); }
  .count { background: var(--blue); color: var(--blue-ink); font-size: 12px; font-weight: 800; border-radius: 999px; padding: 1px 8px; }
  .side form { margin-top: auto; padding: 0 12px; }
  .linkbtn { background: none; border: 0; color: var(--muted); font: 600 14px var(--font-body); cursor: pointer; padding: 4px 0; }
  .linkbtn:hover { color: var(--text); }
  .danger { color: #ff8a8a !important; }

  .main { padding: clamp(24px, 4vw, 48px); max-width: 1080px; width: 100%; }
  .main h1 { font-size: 34px; margin-bottom: 24px; }
  .main h2 { font-size: 18px; margin-bottom: 14px; }
  .toast { background: rgb(62 224 127 / .1); border: 1px solid rgb(62 224 127 / .35); color: #1fa55a; padding: 10px 14px; border-radius: 10px; margin-bottom: 20px; font-weight: 600; font-size: 14px; }
  .muted { color: var(--muted); }
  .small { font-size: 13px; }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
  .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; display: grid; gap: 6px; background: var(--bg-1); }
  .card span { color: var(--muted); font-size: 13px; font-weight: 600; }
  .card b { font: 600 36px/1 var(--font-display); color: var(--accent); }
  .panel { border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; background: var(--bg-1); margin-bottom: 16px; }
  .panel.empty { text-align: center; color: var(--muted); padding: 48px 22px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .two .panel { margin-bottom: 0; }
  .two + .panel { margin-top: 16px; }
  .chart { display: flex; align-items: flex-end; gap: 3px; height: 160px; }
  .bar { flex: 1; height: max(2px, var(--h)); background: linear-gradient(to top, var(--blue-deep), var(--blue)); border-radius: 3px 3px 0 0; position: relative; min-width: 4px; }
  .bar span { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); font-size: 10px; color: var(--faint); padding-bottom: 2px; }
  .chart-axis { display: flex; justify-content: space-between; color: var(--faint); font-size: 12px; margin-top: 8px; }
  .kv { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
