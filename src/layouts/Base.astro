---
import '../styles/global.css';
import { htmlLang, langPath, LANGS, type Lang } from '../data/content';

interface Props { title: string; description: string; lang?: Lang; noindex?: boolean }
const { title, description, lang = 'pt', noindex = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = site + langPath[lang];
const ogLocale = { pt: 'pt_BR', es: 'es_ES', en: 'en_US' }[lang];
---
<!doctype html>
<html lang={htmlLang[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : (
      <>
        <link rel="canonical" href={canonical} />
        {LANGS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={site + langPath[l]} />)}
        <link rel="alternate" hreflang="x-default" href={site + '/'} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Noob Perdido Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + '/og.png'} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
